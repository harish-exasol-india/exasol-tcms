{
  "name": "@tcms/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:up": "node dist/db/migrate-cli.js up",
    "db:down": "node dist/db/migrate-cli.js down",
    "db:seed": "node dist/db/seed-cli.js",
    "docs:api": "node dist/docs/generate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@node-rs/argon2": "^2.2.0",
    "@tcms/shared": "*",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
